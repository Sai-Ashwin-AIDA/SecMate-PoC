# Offline tools need no key or transmission consent.
# Reserved for Slice 2; never copy a parent application's .env.
OPENROUTER_API_KEY=

# Distinct private bearer token for the optional loopback HTTP service.
LOCAL_DOCUMENT_AGENT_ADAPTER_TOKEN=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DOCUMENT_INPUT_DIR=./data/input
DOCUMENT_OUTPUT_DIR=./data/output
ALLOW_OPENROUTER_DOCUMENT_TRANSMISSION=false
REQUEST_TIMEOUT_SECONDS=30
TURN_TIMEOUT_SECONDS=120
MAX_MODEL_CALLS_PER_TURN=8
MAX_TOOL_CALLS_PER_TURN=12
MAX_OUTPUT_TOKENS=2048
CONTEXT_BUDGET_UNITS=32768
MAX_TURN_TOKEN_BUDGET=80000
MAX_HISTORY_TURNS=4
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
